#!/bin/sh
# TKGL Bootstrap - Main script
# Reads doer_list and executes modules in order
# Self-describing: derives all paths from its own location on the SD card.
# Does NOT depend on internal eMMC launcher injecting paths via tkgl_path.

# Derive root from script location (e.g. /media/TKGL_BOOTSTRAP/.../scripts/tkgl_bootstrap)
SELF="$(readlink -f "$0")"                   # resolve symlinks
SCRIPTS_DIR="$(dirname "$SELF")"             # .../scripts
TKGL_ROOT="$(dirname "$SCRIPTS_DIR")"        # .../
MOUNT_POINT="$(dirname "$TKGL_ROOT")"        # /media/TKGL_BOOTSTRAP

# Set standard TKGL paths
TKGL_BIN="$TKGL_ROOT/bin"
TKGL_LIB="$TKGL_ROOT/lib"
TKGL_CONF="$TKGL_ROOT/conf"
TKGL_LOG="$TKGL_ROOT/logs"
TKGL_SCRIPTS="$TKGL_ROOT/scripts"
TKGL_MODULES="$TKGL_ROOT/modules"
TKGL_LOG_FILE="$TKGL_LOG/bootstrap_$(date +%Y%m%d_%H%M%S).log"

# Optionally source tkgl_path for any overrides (e.g. module-specific paths)
if [ -f "$TKGL_SCRIPTS/tkgl_path" ]; then
    . "$TKGL_SCRIPTS/tkgl_path"
fi

BOOTSTRAP_LOG="$TKGL_LOG_FILE"

log() {
    echo "[$(date +%H:%M:%S)] $*" | tee -a "$BOOTSTRAP_LOG"
}

log "=========================================="
log "TKGL Bootstrap starting for Denon Prime GO"
log "Device: $(cat /sys/firmware/devicetree/model 2>/dev/null || echo 'unknown')"
log "=========================================="

# Update PATH
export PATH="$TKGL_BIN:$TKGL_LIB:$PATH"
export LD_LIBRARY_PATH="$TKGL_LIB:$LD_LIBRARY_PATH"

# Source doer_list to get TKGL_DOER
if [ -f "$TKGL_ROOT/doer_list" ]; then
    . "$TKGL_ROOT/doer_list"
    log "doer_list loaded: TKGL_DOER='$TKGL_DOER'"
else
    log "ERROR: doer_list not found at $TKGL_ROOT/doer_list"
    exit 1
fi

# Execute each module in order
for module in $TKGL_DOER; do
    MOD_SCRIPT="$TKGL_MODULES/mod_$module/tkgl_mod_$module.sh"
    log "--- Executing module: $module ---"
    if [ -f "$MOD_SCRIPT" ]; then
        . "$MOD_SCRIPT"
    else
        log "ERROR: Module script not found: $MOD_SCRIPT"
    fi
    log "--- Module $module completed ---"
done

log "=========================================="
log "TKGL Bootstrap completed"
log "=========================================="
