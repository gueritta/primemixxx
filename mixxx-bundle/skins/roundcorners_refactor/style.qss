/* RoundCorners Refactor — Touch-Optimized Dark Theme for 1280x800 */

QWidget {
    background-color: #181818;
    color: #e0e0e0;
    font-family: sans-serif;
    font-size: 11pt;
}

/* Header Bar */
#TopBar {
    background-color: #101010;
    border-bottom: 1px solid #2a2a2a;
}

#MenuButton {
    background-color: #282828;
    color: #ffffff;
    border-radius: 4px;
    padding: 4px 12px;
    min-height: 28px;
}

/* Waveforms */
#WaveformContainer {
    background-color: #0d0d0d;
    border-bottom: 2px solid #222222;
}

/* Decks Strip */
#Deck1, #Deck2 {
    background-color: #1e1e1e;
    border: 1px solid #2d2d2d;
    padding: 6px;
}

#TrackTitle1, #TrackTitle2 {
    font-weight: bold;
    font-size: 12pt;
    color: #00e676;
}

#Deck2 #TrackTitle2 {
    color: #00b0ff;
}

/* Touch Control Buttons */
QPushButton {
    min-width: 60px;
    min-height: 44px;
    font-weight: bold;
    background-color: #2e2e2e;
    border: 1px solid #444444;
    border-radius: 6px;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #444444;
}

/* Library Scaling & Vertical Density */
QTableView::item {
    min-height: 38px;
    padding: 4px;
}

QHeaderView::section {
    height: 36px;
    background-color: #222222;
    font-weight: bold;
}

QTreeView::item {
    min-height: 40px;
}