/* SCROLLBARS
   ========================================================================== */

/**
 * Horizontal
 */
QScrollBar:horizontal {
    border: 0;
    background: transparent;
    height: 8px;
    margin: 0;
    padding: 0;
}

QScrollBar::handle:horizontal {
    background-color: #777777;
    max-width: 20px;
    margin: 0;
}

QScrollBar::add-line:horizontal {
    border: 0;
    background: none;
    width: 0;
    subcontrol-position: right;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal {
    border: 0;
    background: none;
    width: 0;
    subcontrol-position: left;
    subcontrol-origin: margin;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
    margin: 0;
    padding: 0;
}

/**
 * Vertical
 */
QScrollBar:vertical {
    border: 0;
    background: transparent;
    width: 8px;
    margin: 0;
    padding: 0;
}

QScrollBar::handle:vertical {
    background-color: #777777;
    min-height: 50px;
    width: 0;
    margin: 0;
    padding: 0;
}

QScrollBar::add-line:vertical {
    border: 0;
    background: none;
    height: 0;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical {
    border: 0;
    background: none;
    height: 0;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    margin: 0;
    padding: 0;
}




#Deck1,
#Deck2,
#Deck3,
#Deck4 {
    qproperty-layoutAlignment: 'AlignCenter | AlignTop';
}

#EffectChain {
    qproperty-layoutAlignment: 'AlignLeft | AlignTop';
}

#Deck1 #Artist,
#Deck1 #VisualBpm,
#InternalClock #VisualBpm,
#Main #RecordingDuration,
#Deck1 #Time,
#Deck1 #Duration,
#Deck1 #SyncMode {
    color: #77ff88;
    font-size: 20px;
}

#Deck1 #Title,
#Deck1 #VisualKey,
#Deck1 #RateDisplay {
    color: #77ff88;
    font-size: 18px;
}

#Deck2 #Artist,
#Deck2 #VisualBpm,
#Deck2 #Time,
#Deck2 #Duration,
#Deck2 #SyncMode {
    color: #77ff88;
    font-size: 20px;
}

#Deck2 #Title,
#Deck2 #VisualKey,
#Deck2 #RateDisplay {
    color: #77ff88;
    font-size: 18px;
}

#Deck3 #Artist,
#Deck3 #VisualBpm,
#Deck3 #Time,
#Deck3 #Duration,
#Deck3 #SyncMode {
    color: #99dd77;
    font-size: 20px;
}

#Deck3 #Title,
#Deck3 #VisualKey,
#Deck3 #RateDisplay {
    color: #99dd77;
    font-size: 18px;
}


#Deck4 #Artist,
#Deck4 #VisualBpm,
#Deck4 #Time,
#Deck4 #Duration,
#Deck4 #SyncMode {
    color: #88cc66;
    font-size: 20px;
}

#Deck4 #Title,
#Deck4 #VisualKey,
#Deck4 #RateDisplay {
    color: #88cc66;
    font-size: 18px;
}

#Sampler1 #Artist,
#Sampler1 #Title,
#Sampler1 #Hyphen,
#EffectUnit1 #EffectChainName {
    color: #77ff88;
    font-size: 18px;
}

#Sampler1 #Time,
#Sampler1 #VisualBpm,
#Sampler1 #SyncMode {
    color: #77ff88;
    font-size: 20px;
}

#Sampler2 #Artist,
#Sampler2 #Title,
#Sampler2 #Hyphen,
#EffectUnit2 #EffectChainName {
    color: #77ff88;
    font-size: 18px;
}

#Sampler2 #Time,
#Sampler2 #VisualBpm,
#Sampler2 #SyncMode {
    color: #77ff88;
    font-size: 20px;
}

#Sampler3 #Artist,
#Sampler3 #Title,
#Sampler3 #Hyphen,
#EffectUnit3 #EffectChainName {
    color: #99dd77;
    font-size: 18px;
}

#Sampler3 #Time,
#Sampler3 #VisualBpm,
#Sampler3 #SyncMode {
    color: #99dd77;
    font-size: 20px;
}

#Sampler4 #Artist,
#Sampler4 #Title,
#Sampler4 #Hyphen,
#EffectUnit4 #EffectChainName {
    color: #88cc66;
    font-size: 18px;
}

#Sampler4 #Time,
#Sampler4 #VisualBpm,
#Sampler4 #SyncMode {
    color: #88cc66;
    font-size: 20px;
}

#KnobLabel,
#EffectKnobLabel,
#EqualizerEffectKnobLabel {
    color: #ffffff;
    font-size: 18px;
    line-height: 13px;
    qproperty-alignment: 'AlignCenter';
    text-transform: uppercase;
}

#EffectName {
    border: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    background-color: #777777;
    color: #000000;
    margin: 0 0 1px 0;
    font-size: 14px;
    line-height: 16px;
}


#PreviewDeck #Artist,
#PreviewDeck #Title,
#PreviewDeck #Hyphen {
    color: #77ff88;
    font-size: 20px;
}

#Row {
    qproperty-layoutAlignment: 'AlignCenter | AlignTop';
}

#Line {
    border: 0;
    border-radius: 0;
    background-color: #777777;
}

#Logo {
    background: transparent url(skin:/background/logo.png) no-repeat center left;
    padding-top: 44px;
}

#Version {
    font-size: 14px;
    background: transparent;
    color: #777777;
}

#Time {
    font-size: 20px;
    background: transparent;
    color: #ffffff;
}

#ConfigHeadline {
    font-size: 15px;
    background: transparent;
    border: 0;
    color: #ffffff;
    margin: 0;
}

#ConfigLabel {
    font-size: 20px;
    background: transparent;
    border: 0;
    color: #ffffff;
    margin: 0;
}

/* DEVICE-LABELS
   ========================================================================== */

/**
 * General Label Styles
 */
#DeckLabel {
    font-size: 20px;
    background: transparent;
    border: 0;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-left-radius: 5px;
    color: #000000;
    margin: 0;
}

#SamplerLabel,
#EffectLabel {
    font-size: 18px;
    background: transparent;
    border: 0;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-left-radius: 5px;
    color: #000000;
    margin: 0;
}

/**
 * Deck1
 */
#Deck1 #DeckLabel {
    background-color: #5cff2e;
}

/**
 * Deck2
 */
#Deck2 #DeckLabel {
    background-color: #5cff2e;
}

/**
 * Deck3
 */
#Deck3 #DeckLabel {
    background-color: #88cc66;
}

/**
 * Deck4
 */
#Deck4 #DeckLabel {
    background-color: #77bb55;
}

/**
 * Sampler1
 */
#Sampler1 #SamplerLabel {
    background-color: #5cff2e;
}

/**
 * Sampler2
 */
#Sampler2 #SamplerLabel {
    background-color: #55ee88;
}

/**
 * Sampler3
 */
#Sampler3 #SamplerLabel {
    background-color: #88cc66;
}

/**
 * Sampler4
 */
#Sampler4 #SamplerLabel {
    background-color: #77bb55;
}

/**
 * EffectUnit1
 */
#EffectUnit1 #EffectLabel {
    background-color: #5cff2e;
}

/**
 * EffectUnit2
 */
#EffectUnit2 #EffectLabel {
    background-color: #5cff2e;
}

 /**
 * EffectUnit3
 */
#EffectUnit3 #EffectLabel {
    background-color: #88cc66;
}

 /**
 * EffectUnit4
 */
#EffectUnit4 #EffectLabel {
    background-color: #77bb55;
}


