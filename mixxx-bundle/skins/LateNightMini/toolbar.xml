<Template>
  <WidgetGroup>
    <ObjectName>ToolBar</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>e,min</SizePolicy>
    <Children>

      <WidgetGroup>
        <ObjectName>ToolbarSeparator</ObjectName>
        <Size>12f,9min</Size>
      </WidgetGroup>

      <PushButton>
        <TooltipId>maximize_library</TooltipId>
        <ObjectName>ToolbarLibraryBtn</ObjectName>
        <Size>36f,36f</Size>
        <NumberStates>2</NumberStates>
        <RightClickIsPushButton>false</RightClickIsPushButton>
        <State>
          <Number>0</Number>
          <Text>L</Text>
          <Alignment>center</Alignment>
        </State>
        <State>
          <Number>1</Number>
          <Text>←</Text>
          <Alignment>center</Alignment>
        </State>
        <Connection>
          <ConfigKey>[Skin],show_maximized_library</ConfigKey>
        </Connection>
      </PushButton>

      <WidgetGroup>
        <ObjectName>ToolbarSeparator</ObjectName>
        <Size>12f,9min</Size>
      </WidgetGroup>

      <WidgetGroup><!-- GUI toggles with regular library -->
        <ObjectName>ToolBarSection</ObjectName>
        <SizePolicy>min,min</SizePolicy>
        <Layout>horizontal</Layout>
        <Children>

          <PushButton>
            <TooltipId>show_waveforms</TooltipId>
            <ObjectName>ToolbarWaveformBtn</ObjectName>
            <Size>36f,36f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>W</Text>
              <Alignment>center</Alignment>
            </State>
            <State>
              <Number>1</Number>
              <Text>W</Text>
              <Alignment>center</Alignment>
            </State>
            <Connection>
              <ConfigKey>[Skin],show_waveforms</ConfigKey>
            </Connection>
          </PushButton>

        <WidgetGroup>
            <ObjectName>ToolbarSeparator</ObjectName>
            <Size>12f,9min</Size>
        </WidgetGroup>

          <PushButton>
            <TooltipId>show_effects</TooltipId>
            <ObjectName>ToolbarEffectsBtn</ObjectName>
            <Size>36f,36f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>FX</Text>
              <Alignment>center</Alignment>
            </State>
            <State>
              <Number>1</Number>
              <Text>FX</Text>
              <Alignment>center</Alignment>
            </State>
            <Connection>
              <ConfigKey>[Skin],show_effectrack</ConfigKey>
            </Connection>
          </PushButton>

          <PushButton>
            <TooltipId>show_samplers</TooltipId>
            <ObjectName>ToolbarSamplerBtn</ObjectName>
            <Size>36f,36f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>S</Text>
              <Alignment>center</Alignment>
            </State>
            <State>
              <Number>1</Number>
              <Text>S</Text>
              <Alignment>center</Alignment>
            </State>
            <Connection>
              <ConfigKey>[Skin],show_samplers</ConfigKey>
            </Connection>
          </PushButton>

        </Children>
        <Connection>
          <ConfigKey>[Skin],show_maximized_library</ConfigKey>
          <Transform><Not/></Transform>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup><!-- GUI toggles with regular library -->

      <WidgetGroup><!-- GUI toggles with maximized library -->
        <ObjectName>ToolBarSection</ObjectName>
        <SizePolicy>min,min</SizePolicy>
        <Layout>horizontal</Layout>
        <Children>

          <PushButton>
            <TooltipId>show_waveforms</TooltipId>
            <ObjectName>ToolbarDecksBtn</ObjectName>
            <Size>36f,36f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>D</Text>
              <Alignment>center</Alignment>
            </State>
            <State>
              <Number>1</Number>
              <Text>D</Text>
              <Alignment>center</Alignment>
            </State>
            <Connection>
              <ConfigKey>[LateNightMini],max_lib_show_decks</ConfigKey>
            </Connection>
          </PushButton>

        </Children>
        <Connection>
          <ConfigKey>[Skin],show_maximized_library</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup><!-- GUI toggles with maximized library -->

      <WidgetGroup><Size>me,min</Size></WidgetGroup>

      <StatusLight>
        <TooltipId>autodj_status</TooltipId>
        <ObjectName>AutoDjStatus</ObjectName>
        <Size>30f,36f</Size>
        <NumberPos>3</NumberPos>
        <PathStatusLight1>skin:/<Variable name="StyleScheme"/>/style/autodj_status.svg</PathStatusLight1>
        <PathStatusLight2>skin:/<Variable name="StyleScheme"/>/style/autodj_status.svg</PathStatusLight2>
        <PathStatusLight3>skin:/<Variable name="StyleScheme"/>/style/autodj_status.svg</PathStatusLight3>
        <Connection>
          <ConfigKey>[AutoDJ],enabled</ConfigKey>
        </Connection>
        <Connection>
          <ConfigKey>[AutoDJ],enabled</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </StatusLight>

      <WidgetGroup><Size>7f,1min</Size></WidgetGroup>

      <WidgetGroup>
        <ObjectName>ToolbarMainVuMeterBox</ObjectName>
        <Size>92f,18f</Size>
        <SizePolicy>f,min</SizePolicy>
        <Layout>vertical</Layout>
        <Children>
          <Template src="skin:/mixer/vumeter_main_horizontal.xml"/>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>7f,1min</Size></WidgetGroup>

      <WidgetGroup><!-- Recording button -->
        <ObjectName>RecBox</ObjectName>
        <Layout>stacked</Layout>
        <Size>30f,36f</Size>
        <Children>
          <PushButton>
            <ObjectName>RecButton</ObjectName>
            <TooltipId>toggle_recording</TooltipId>
            <Size>30f,36f</Size>
            <NumberStates>1</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
            </State>
            <Connection>
              <ConfigKey>[Recording],toggle_recording</ConfigKey>
            </Connection>
          </PushButton>
          <Label>
            <ObjectName>RecDot</ObjectName>
            <Size>30f,36f</Size>
            <Text>●</Text>
            <Alignment>center</Alignment>
            <Connection>
              <ConfigKey>[Recording],status</ConfigKey>
              <BindProperty>highlight</BindProperty>
            </Connection>
          </Label>
          <Template src="skin:/controls/button_3state_display.xml">
            <SetVariable name="ObjectName">RecFeedback</SetVariable>
            <SetVariable name="Size">30f,36f</SetVariable>
            <SetVariable name="ConfigKey">[Recording],toggle_recording</SetVariable>
            <SetVariable name="ConfigKeyDisp">[Recording],status</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>7f,1min</Size></WidgetGroup>

      <WidgetGroup>
        <ObjectName>BatteryBox</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <Battery>
            <ObjectName>Battery</ObjectName>
            <Size>30f,36f</Size>
            <SizePolicy>min,min</SizePolicy>
            <PixmapCharged scalemode="STRETCH_ASPECT">skin:/<Variable name="StyleScheme"/>/style/batt/ic_battery_charged.svg</PixmapCharged>
            <NumberStates>8</NumberStates>
            <PixmapsCharging scalemode="STRETCH_ASPECT">skin:/<Variable name="StyleScheme"/>/style/batt/ic_battery_charging_%1.svg</PixmapsCharging>
            <PixmapsDischarging scalemode="STRETCH_ASPECT">skin:/<Variable name="StyleScheme"/>/style/batt/ic_battery_discharging_%1.svg</PixmapsDischarging>
          </Battery>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>7f,1min</Size></WidgetGroup>

      <Label>
        <ObjectName>XrunBolt</ObjectName>
        <Text>⚡</Text>
        <Size>18f,36f</Size>
        <Alignment>center</Alignment>
        <Connection>
          <ConfigKey>[App],audio_latency_overload</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </Label>

      <WidgetGroup><Size>7f,1min</Size></WidgetGroup>

      <WidgetGroup>
        <ObjectName>ClockWidget</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Alignment>right</Alignment>
        <Children>
          <Time>
            <TooltipId>time</TooltipId>
          </Time>
        </Children>
      </WidgetGroup>

    </Children>
    <Connection>
      <ConfigKey>[Skin],show_waveforms</ConfigKey>
      <BindProperty>highlight</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
