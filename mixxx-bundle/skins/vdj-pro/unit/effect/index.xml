<!DOCTYPE template>
<Template>

    <!--
    **************************************************************************************
    EFFECT UNIT BEGIN
    **************************************************************************************
    -->
    <WidgetGroup>
        <ObjectName>Row</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,max</SizePolicy>
        <!-- Fixed height to prevent layout shift when effect rack is hidden.
             Reserving 100px keeps touch coordinates aligned. -->
        <MinimumSize>-1,100</MinimumSize>
        <Children>

            <SizeAwareStack>
                <Children>
                    <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <MinimumSize>0,0</MinimumSize>
                        <MaximumSize>899,-1</MaximumSize>
                        <Children>

                            <Template src="skin:unit/effect/800.xml"/>

                        </Children>
                    </WidgetGroup>
                    <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <MinimumSize>900,0</MinimumSize>
                        <MaximumSize>999,-1</MaximumSize>
                        <Children>

                            <Template src="skin:unit/effect/1152.xml"/>

                        </Children>
                    </WidgetGroup>
                    <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <MinimumSize>1000,0</MinimumSize>
                        <MaximumSize>1062,-1</MaximumSize>
                        <Children>

                            <Template src="skin:unit/effect/1280.xml"/>

                        </Children>
                    </WidgetGroup>
                    <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <MinimumSize>1063,0</MinimumSize>
                        <MaximumSize>1124,-1</MaximumSize>
                        <Children>

                            <Template src="skin:unit/effect/1360.xml"/>

                        </Children>
                    </WidgetGroup>
                    <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <MinimumSize>1125,0</MinimumSize>
                        <MaximumSize>1249,-1</MaximumSize>
                        <Children>

                            <Template src="skin:unit/effect/1440.xml"/>

                        </Children>
                    </WidgetGroup>
                    <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <MinimumSize>1250,0</MinimumSize>
                        <MaximumSize>1499,-1</MaximumSize>
                        <Children>

                            <Template src="skin:unit/effect/1600.xml"/>

                        </Children>
                    </WidgetGroup>
                    <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <MinimumSize>1500,0</MinimumSize>
                        <Children>

                            <Template src="skin:unit/effect/1920.xml"/>

                        </Children>
                    </WidgetGroup>
                </Children>
                <!-- visible moved from outer container to inner stack;
                     container stays at MinimumSize when content hidden -->
                <Connection>
                    <ConfigKey persist="true">[EffectRack<Variable name="EffectRackNumber"/>],show</ConfigKey>
                    <BindProperty>visible</BindProperty>
                </Connection>
            </SizeAwareStack>

        </Children>
    </WidgetGroup>
    <!--
    **************************************************************************************
    EFFECT UNIT END
    **************************************************************************************
    -->

</Template>