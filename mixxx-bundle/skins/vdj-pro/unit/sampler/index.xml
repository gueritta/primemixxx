<!DOCTYPE template>
<Template>

    <!--
    **************************************************************************************
    SAMPLER UNIT BEGIN
    **************************************************************************************
    -->
    <WidgetGroup>
        <ObjectName>Row</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,max</SizePolicy>
        <!-- Do not reserve phantom height when the sampler rack is hidden. -->
        <MinimumSize>-1,0</MinimumSize>
        <Children>

            <SizeAwareStack>
                <Children>
                    <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <MinimumSize>0,0</MinimumSize>
                        <MaximumSize>899,-1</MaximumSize>
                        <Children>

                            <Template src="skin:unit/sampler/800.xml"/>

                        </Children>
                    </WidgetGroup>
                    <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <MinimumSize>900,0</MinimumSize>
                        <MaximumSize>999,-1</MaximumSize>
                        <Children>

                            <Template src="skin:unit/sampler/1152.xml"/>

                        </Children>
                    </WidgetGroup>
                    <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <MinimumSize>1000,0</MinimumSize>
                        <MaximumSize>1062,-1</MaximumSize>
                        <Children>

                            <Template src="skin:unit/sampler/1280.xml"/>

                        </Children>
                    </WidgetGroup>
                    <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <MinimumSize>1063,0</MinimumSize>
                        <MaximumSize>1124,-1</MaximumSize>
                        <Children>

                            <Template src="skin:unit/sampler/1360.xml"/>

                        </Children>
                    </WidgetGroup>
                    <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <MinimumSize>1125,0</MinimumSize>
                        <MaximumSize>1249,-1</MaximumSize>
                        <Children>

                            <Template src="skin:unit/sampler/1440.xml"/>

                        </Children>
                    </WidgetGroup>
                    <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <MinimumSize>1250,0</MinimumSize>
                        <MaximumSize>1499,-1</MaximumSize>
                        <Children>

                            <Template src="skin:unit/sampler/1600.xml"/>

                        </Children>
                    </WidgetGroup>
                    <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <MinimumSize>1500,0</MinimumSize>
                        <Children>

                            <Template src="skin:unit/sampler/1920.xml"/>

                        </Children>
                    </WidgetGroup>
                </Children>
                <!-- visible moved from outer container to inner stack;
                     container stays at MinimumSize when content hidden -->
                <Connection>
                    <ConfigKey persist="true">[Samplers],show_samplers</ConfigKey>
                    <BindProperty>visible</BindProperty>
                </Connection>
            </SizeAwareStack>

        </Children>
    </WidgetGroup>
    <!--
    **************************************************************************************
    SAMPLER UNIT END
    **************************************************************************************
    -->

</Template>