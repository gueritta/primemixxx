<!--
  Touch-friendly 2-state button for skin settings submenu toggles.
  No ButtonState — auto-detects PUSH mode for regular COs (_trig).
  Height 40f for industrial touchscreen (was 18f).
  Writes to _trig CO; JS helper toggles the real visibility CO.
Variables:
  Width        : button width
  Text         : label text
  TooltipId    : tooltip
  Setting      : [LateNightMini],key_trig (trigger CO)
-->
<Template>
  <PushButton>
    <TooltipId><Variable name="TooltipId"/></TooltipId>
    <ObjectName>SkinSettingsButton</ObjectName>
    <LeftClickIsPushButton>true</LeftClickIsPushButton>
    <Size><Variable name="Width"/>,40f</Size>
    <NumberStates>2</NumberStates>
    <State>
      <Number>0</Number>
      <Text>&#8202;&#8202;&#9744;  <Variable name="Text"/></Text>
      <Alignment>left</Alignment>
    </State>
    <State>
      <Number>1</Number>
      <Text>&#8202;&#8202;&#8202;&#10004;&#8202;&#8202; <Variable name="Text"/></Text>
      <Alignment>left</Alignment>
    </State>
    <Connection>
      <ConfigKey persist="true"><Variable name="Setting"/></ConfigKey>
    </Connection>
  </PushButton>
</Template>
