<Template>

  <WidgetGroup>
    <Layout>vertical</Layout>
    <MaximumSize>,230</MaximumSize>
    <Children>

      <Template src="skin:/decks/deck_singletons.xml">
        <SetVariable name="Type">deck</SetVariable>
        <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
      </Template>

      <WidgetStack currentpage="[LateNightMini],deck_size_without_mixer" persist="true">
        <Children>
          <!-- minimal deck selected -->
          <WidgetGroup trigger="[LateNightMini],show_mini_deck">
            <Layout>horizontal</Layout>
            <Children>
              <SingletonContainer>
                <ObjectName>Deck<Variable name="ChanNum"/>_Mini</ObjectName>
              </SingletonContainer>
            </Children>
          </WidgetGroup>
          <!-- Compact deck selected -->
          <WidgetGroup trigger="[LateNightMini],show_compact_deck">
            <Layout>horizontal</Layout>
            <Children>
            <SingletonContainer>
              <ObjectName>Deck<Variable name="ChanNum"/>_Compact</ObjectName>
            </SingletonContainer>
            </Children>
          </WidgetGroup>
          <!-- Full deck selected -->
          <WidgetGroup trigger="[LateNightMini],show_full_deck">
            <Layout>horizontal</Layout>
            <Children>
              <SingletonContainer>
                <ObjectName>Deck<Variable name="ChanNum"/>_Full</ObjectName>
              </SingletonContainer>
            </Children>
          </WidgetGroup>

        </Children>
      </WidgetStack>

    </Children>
  </WidgetGroup>
</Template>
