<!DOCTYPE template>
<Template>

    <!--
    **************************************************************************************
    SAMPLER UNIT BEGIN
    **************************************************************************************
    -->
    <WidgetGroup>
        <ObjectName>Row</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,max</SizePolicy>
        <!-- Do not reserve phantom height when the sampler rack is hidden. -->
        <MinimumSize>-1,0</MinimumSize>
        <Children>

            <SizeAwareStack>
                <Children>
                    <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <MaximumSize>900,-1</MaximumSize>
                        <Children>

                            <Template src="skin:unit/sampler/800.xml"/>

                        </Children>
                    </WidgetGroup>
                    <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <MinimumSize>901,0</MinimumSize>
                        <MaximumSize>1100,-1</MaximumSize>
                        <Children>

                            <Template src="skin:unit/sampler/1024.xml"/>

                        </Children>
                    </WidgetGroup>
                    <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <MinimumSize>1101,0</MinimumSize>
                        <Children>

                            <Template src="skin:unit/sampler/1360.xml"/>

                        </Children>
                    </WidgetGroup>
                </Children>
                <!-- visible moved from outer container to inner stack;
                     container stays at MinimumSize when content hidden -->
                <Connection>
                    <ConfigKey persist="true">[Samplers],show_samplers</ConfigKey>
                    <BindProperty>visible</BindProperty>
                </Connection>
            </SizeAwareStack>

        </Children>
    </WidgetGroup>
    <!--
    **************************************************************************************
    SAMPLER UNIT END
    **************************************************************************************
    -->

</Template>