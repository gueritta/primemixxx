/**
 * General Button Styles
 */
#Btn-br {
    border: 0;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-left-radius: 6px;
    background-color: #888888;
    color: #000000;
    margin: 0;
    font-size: 22px;
}

#Btn-btr {
    border: 0;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-left-radius: 6px;
    background-color: #888888;
    color: #000000;
    margin: 0 0 1px 0;
    font-size: 22px;
}

#Btn-bbr {
    border: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-left-radius: 0;
    background-color: #888888;
    color: #000000;
    margin: 0 0 1px 0;
    font-size: 22px;
}

#Btn-blr {
    border: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 6px;
    border-top-left-radius: 6px;
    background-color: #888888;
    color: #000000;
    margin: 0;
    font-size: 22px;
}

#Btn-brr {
    border: 0;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 0;
    border-top-left-radius: 0;
    background-color: #888888;
    color: #000000;
    margin: 0 0 0 1px;
    font-size: 22px;
}

#Btn-btlr {
    border: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-left-radius: 6px;
    background-color: #888888;
    color: #000000;
    margin: 0 0 1px 0;
    font-size: 22px;
}

