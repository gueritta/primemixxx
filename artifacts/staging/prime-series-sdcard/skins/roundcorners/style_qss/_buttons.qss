/* BUTTONS
   ========================================================================== */

/**
 * Menubar Icons
 */
#MenuBar #Visuals #Btn-btlr {
    background-image: url(skin:button/visuals.svg);
    background-repeat: no-repeat;
    background-position: center;
}

#MenuBar #Visuals-2 #Btn-btlr {
    background-image: url(skin:button/visuals_2.svg);
    background-repeat: no-repeat;
    background-position: center;
}

#MenuBar #Settings #Btn-bblr {
    background-image: url(skin:button/settings.svg);
    background-repeat: no-repeat;
    background-position: center;
}

#MenuBar #Settings-2 #Btn-bblr {
    background-image: url(skin:button/settings_2.svg);
    background-repeat: no-repeat;
    background-position: center;
}

#MenuBar #Decks #Btn-nbr-bisected, #MenuBar #Decks #Btn-nbr {
    background-image: url(skin:button/decks.svg);
    background-repeat: no-repeat;
    background-position: center;
}

#MenuBar #Decks-2 #Btn-nbr-bisected, #MenuBar #Decks-2 #Btn-nbr {
    background-image: url(skin:button/decks_2.svg);
    background-repeat: no-repeat;
