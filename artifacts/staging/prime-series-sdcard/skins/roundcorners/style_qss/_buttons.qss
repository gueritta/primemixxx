}

/**
 * Hover
 */
#Btn-br:hover,
#Btn-btr:hover,
#Btn-bbr:hover,
#Btn-blr:hover,
#Btn-brr:hover,
#Btn-btlr:hover,
#Btn-btrr:hover,
#Btn-bblr:hover,
#Btn-bbrr:hover,
#Btn-nbr:hover,
#Btn-nbr-bisected:hover {
    background-color: #555555;
}

/**
 * MenuBar
 */
#MenuBar #Btn-btlr[value="1"],
#MenuBar #Btn-bblr[value="1"],
#MenuBar #Btn-btrr[value="1"],
#MenuBar #Btn-bbrr[value="1"],
#MenuBar #Btn-nbr-bisected[value="1"] {
    background-color: #5cff2e;
}

#MenuBar #Btn-btlr[value="1"]:hover,
#MenuBar #Btn-bblr[value="1"]:hover,
#MenuBar #Btn-btrr[value="1"]:hover,
#MenuBar #Btn-bbrr[value="1"]:hover,
#MenuBar #Btn-nbr-bisected[value="1"]:hover {
    background-color: #44dd55;
}

