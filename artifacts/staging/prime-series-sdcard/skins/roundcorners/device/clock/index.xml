<!DOCTYPE template>
<Template>

    <!--
    **************************************************************************************
    CLOCK DEVICE BEGIN
    **************************************************************************************
    -->
    <WidgetGroup>
        <ObjectName>Clock</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>max,max</SizePolicy>
        <MaximumSize>110,69</MaximumSize>
        <Children>

            <Template src="skin:device/clock/border_top.xml"/>

            <WidgetGroup>
                <ObjectName>Rectangle</ObjectName>
                <Layout>horizontal</Layout>
                <SizePolicy>min,max</SizePolicy>
                <MinimumSize>,48</MinimumSize>
                <Children>

                    <WidgetGroup><!-- spacer -->
                        <MinimumSize>12,-1</MinimumSize>
                        <MaximumSize>12,-1</MaximumSize>
                    </WidgetGroup>

                        <Time>
                            <ObjectName>Time</ObjectName>
                            <TooltipId>time</TooltipId>
                            <ShowSeconds>false</ShowSeconds>
                        </Time>

                    <WidgetGroup><!-- spacer -->
                        <MinimumSize>12,-1</MinimumSize>
                        <MaximumSize>12,-1</MaximumSize>
                    </WidgetGroup>

                </Children>
            </WidgetGroup>

            <Template src="skin:device/clock/border_bottom.xml"/>

        </Children>
        <Connection>
            <ConfigKey persist="true">[Clock],show_clock</ConfigKey>
            <BindProperty>visible</BindProperty>
        </Connection>
    </WidgetGroup>

    <WidgetGroup><!-- margin-right -->
        <MinimumSize>6,-1</MinimumSize>
        <MaximumSize>6,-1</MaximumSize>
        <Connection>
            <ConfigKey persist="true">[Clock],show_clock</ConfigKey>
            <BindProperty>visible</BindProperty>
        </Connection>
    </WidgetGroup>
    <!--
    **************************************************************************************
    CLOCK DEVICE END
    **************************************************************************************
    -->

</Template>