<!DOCTYPE template>
<Template>

    <!--
    **************************************************************************************
    PITCH-CONTROLS BEGIN
    **************************************************************************************
    -->
    <WidgetGroup>
        <Layout>horizontal</Layout>
        <Size>188f,48f</Size>
        <Children>

            <PushButton>
                <ObjectName>Btn-btlr</ObjectName>
                <TooltipId>rate_perm_down_rate_perm_down_small</TooltipId>
                <Size>44f,48f</Size>
                <NumberStates>1</NumberStates>
                <State><Number>0</Number><Text>-</Text></State>
                <Connection><ConfigKey><Variable name="Group"/>,rate_perm_down</ConfigKey><EmitOnPressAndRelease>true</EmitOnPressAndRelease><ButtonState>LeftButton</ButtonState></Connection>
                <Connection><ConfigKey><Variable name="Group"/>,rate_perm_down_small</ConfigKey><EmitOnPressAndRelease>true</EmitOnPressAndRelease><ButtonState>RightButton</ButtonState></Connection>
            </PushButton>

            <PushButton>
                <ObjectName>Btn-nbr-bisected</ObjectName>
                <TooltipId>rate_perm_up_rate_perm_up_small</TooltipId>
                <Size>44f,48f</Size>
                <NumberStates>1</NumberStates>
                <State><Number>0</Number><Text>+</Text></State>
                <Connection><ConfigKey><Variable name="Group"/>,rate_perm_up</ConfigKey><EmitOnPressAndRelease>true</EmitOnPressAndRelease><ButtonState>LeftButton</ButtonState></Connection>
                <Connection><ConfigKey><Variable name="Group"/>,rate_perm_up_small</ConfigKey><EmitOnPressAndRelease>true</EmitOnPressAndRelease><ButtonState>RightButton</ButtonState></Connection>
            </PushButton>

            <PushButton>
               <ObjectName>Btn-nbr-bisected</ObjectName>
                <TooltipId>rate_temp_down_rate_temp_down_small</TooltipId>
                <Size>44f,48f</Size>
                <NumberStates>1</NumberStates>
                <State><Number>0</Number><Text>&lt;</Text></State>
                <Connection><ConfigKey><Variable name="Group"/>,rate_temp_down</ConfigKey><EmitOnPressAndRelease>true</EmitOnPressAndRelease><ButtonState>LeftButton</ButtonState></Connection>
                <Connection><ConfigKey><Variable name="Group"/>,rate_temp_down_small</ConfigKey><EmitOnPressAndRelease>true</EmitOnPressAndRelease><ButtonState>RightButton</ButtonState></Connection>
            </PushButton>

            <PushButton>
                <ObjectName>Btn-btrr</ObjectName>
                <TooltipId>rate_temp_up_rate_temp_up_small</TooltipId>
                <Size>44f,48f</Size>
                <NumberStates>1</NumberStates>
                <State><Number>0</Number><Text>&gt;</Text></State>
                <Connection><ConfigKey><Variable name="Group"/>,rate_temp_up</ConfigKey><EmitOnPressAndRelease>true</EmitOnPressAndRelease><ButtonState>LeftButton</ButtonState></Connection>
                <Connection><ConfigKey><Variable name="Group"/>,rate_temp_up_small</ConfigKey><EmitOnPressAndRelease>true</EmitOnPressAndRelease><ButtonState>RightButton</ButtonState></Connection>
            </PushButton>

        </Children>
        <Connection>
            <ConfigKey persist="true"><Variable name="Widget"/>,show_pitch</ConfigKey>
            <BindProperty>visible</BindProperty>
        </Connection>
    </WidgetGroup>

    <WidgetGroup><!-- margin-right -->
        <MinimumSize>12,-1</MinimumSize>
        <MaximumSize>12,-1</MaximumSize>
    </WidgetGroup>
    <!--
    **************************************************************************************
    PITCH-CONTROLS END
    **************************************************************************************
    -->

</Template>
