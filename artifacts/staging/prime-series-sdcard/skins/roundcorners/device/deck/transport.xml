<!DOCTYPE template>
<Template>

    <!--
    **************************************************************************************
    TRANSPORT BEGIN
    **************************************************************************************
    -->
    <WidgetGroup>
        <ObjectName>TransportRow</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>-1,48</MinimumSize>
        <MaximumSize>-1,48</MaximumSize>
        <Children>

            <WidgetGroup><!-- margin-top -->
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>-1,0</MinimumSize>
                <MaximumSize>-1,0</MaximumSize>
            </WidgetGroup>

            <WidgetGroup>
                <Layout>horizontal</Layout>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>-1,48</MinimumSize>
                <MaximumSize>-1,48</MaximumSize>
                <Children>

                    <WidgetGroup><!-- margin-left -->
                        <SizePolicy>f,f</SizePolicy>
                        <MinimumSize>10,48</MinimumSize>
                        <MaximumSize>10,48</MaximumSize>
                    </WidgetGroup>

                    <SizeAwareStack>
                        <Children>
                           <WidgetGroup>
                                <Layout>horizontal</Layout>
                                <MinimumSize>0,48</MinimumSize>
                                <MaximumSize>485,48</MaximumSize>
                                <Children>

                                    <Template src="skin:device/deck/transport_controls_sm.xml"/>

                                </Children>
                           </WidgetGroup>
                           <WidgetGroup>
                                <Layout>horizontal</Layout>
                                <MinimumSize>486,48</MinimumSize>
                                <MaximumSize>600,48</MaximumSize>
                                <Children>

                                    <Template src="skin:device/deck/transport_controls_sm.xml"/>

                                </Children>
                           </WidgetGroup>
                           <WidgetGroup>
                                <Layout>horizontal</Layout>
                                <MinimumSize>601,48</MinimumSize>
                                <MaximumSize>-1,48</MaximumSize>
                                <Children>

                                    <Template src="skin:device/deck/transport_controls_lg.xml"/>

                                </Children>
                           </WidgetGroup>
                        </Children>
                    </SizeAwareStack>

                </Children>
            </WidgetGroup>

        </Children>
        <Connection>
            <ConfigKey persist="true"><Variable name="Widget"/>,show_transport</ConfigKey>
            <BindProperty>visible</BindProperty>
        </Connection>
    </WidgetGroup>
    <!--
    **************************************************************************************
    TRANSPORT END
    **************************************************************************************
    -->

</Template>