<!DOCTYPE template>
<Template>

    <!--
    **************************************************************************************
    MIXER BUTTON BEGIN
    **************************************************************************************
    -->
    <WidgetGroup>
        <Layout>horizontal</Layout>
        <MinimumSize>68,48</MinimumSize>
        <MaximumSize>68,48</MaximumSize>
        <Children>

            <WidgetGroup><!-- margin-left -->
                <MinimumSize>14,-1</MinimumSize>
                <MaximumSize>14,-1</MaximumSize>
            </WidgetGroup>

            <PushButton>
                <ObjectName><Variable name="ObjectName"/></ObjectName>
                <TooltipId><Variable name="TooltipId"/></TooltipId>
                <Size>48f,48f</Size>
                <NumberStates>2</NumberStates>
                <State>
                    <Number>0</Number>
                    <Text><Variable name="Label"/></Text>
                </State>
                <State>
                    <Number>1</Number>
                    <Text><Variable name="Label"/></Text>
                </State>
                <Connection>
                    <ConfigKey><Variable name="ConfigKey"/></ConfigKey>
                    <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                    <ButtonState>LeftButton</ButtonState>
                </Connection>
            </PushButton>

            <WidgetGroup><!-- margin-right -->
                <MinimumSize>14,-1</MinimumSize>
                <MaximumSize>14,-1</MaximumSize>
            </WidgetGroup>

        </Children>
    </WidgetGroup>
    <!--
    **************************************************************************************
    MIXER BUTTON END
    **************************************************************************************
    -->

</Template>